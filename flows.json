  {
    "id": "a83ac44cf60c4d5e",
    "type": "function",
    "z": "e1bc5f42c0a04591",
    "name": "Validar y procesar",
    "func": "const texto = String(msg.payload).trim();\nif (!/^(?:\\d+)(?:\\.\\d+)?$/.test(texto)) {\n    node.warn('Lectura no numérica: ' + texto);\n    return null;\n}\nconst lux = Number(texto);\nif (!Number.isFinite(lux)) return null;\nconst lectura = { fecha: new Date().toISOString(), lux, estado: lux > 1000 ? 'ALERTA' : 'NORMAL' };\nconst anteriores = flow.get('lecturas') || [];\nanteriores.push(lectura);\nflow.set('lecturas', anteriores.slice(-50));\nnode.status({ fill: lectura.estado === 'ALERTA' ? 'red' : 'green', shape: 'dot', text: `${lux} lux - ${lectura.estado}` });\nreturn [ { payload: lectura }, { payload: `${lectura.fecha},${lux},${lectura.estado}` } ];",
